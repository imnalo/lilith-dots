#!/bin/sh
# ======================================================================
#  lilith-rice — sets up the whole desktop on Void Linux with one command
# ----------------------------------------------------------------------
#  Run  ./lilith-rice help  for the command list.
#  Every step is idempotent (safe to re-run). Files it replaces are
#  backed up to ~/.config-backup/<timestamp>/ first.
#
#  Sections:  1 settings · 2 helpers · 3 packages · 4 services · 5 network
#             6 wallpapers · 7 Strata · 8 source + config + build
#             9 verify · 10 install/update · 11 dispatch
# ======================================================================
set -u

# ---------------------------------------------------------------- 1. settings
SELF=$(readlink -f "$0")
RICE_HOME=$(dirname "$SELF")
CONF="${XDG_CONFIG_HOME:-$HOME/.config}"
LILITH_SRC="${LILITH_SRC:-$HOME/.local/src/lilith}"
LILITH_URL="https://github.com/ohto121/lilith"
STRATA_API="https://api.github.com/repos/lgse/strata/releases/latest"
WALLPAPERS="$HOME/Pictures/Wallpapers"
FONT_DIR="$HOME/.local/share/fonts/lilith"
# Pinned downloads (SHA-256 from the FreeBSD ports distinfo of each release).
GALLANT_URL="https://codeload.github.com/NanoBillion/gallant/tar.gz/v0.1"
GALLANT_SHA="bb5477bb2b0c2e06b0242d1c6da17d957d78654fb4df9374dc49862b67b75c40"
JETBRAINS_URL="https://github.com/JetBrains/JetBrainsMono/releases/download/v2.304/JetBrainsMono-2.304.zip"
JETBRAINS_SHA="6f6376c6ed2960ea8a963cd7387ec9d76e3f629125bc33d1fdcd7eb7012f7bbf"
GROTESK_URL="https://github.com/floriankarsten/space-grotesk/releases/download/2.0.0/SpaceGrotesk-2.0.0.zip"
NERD_URL="https://github.com/ryanoasis/nerd-fonts/releases/latest/download/NerdFontsSymbolsOnly.zip"
ZEN_URL="https://github.com/zen-browser/desktop/releases/latest/download/zen.linux-x86_64.tar.xz"
ZED_URL="https://cloud.zed.dev/releases/stable/latest/download?asset=zed&arch=x86_64&os=linux&source=docs"
BACKUP="$HOME/.config-backup/$(date +%Y%m%d-%H%M%S)"
DRY="${DRY:-0}"          # DRY=1: print privileged commands instead of running them
PROBLEMS=0
# Tools installed by this script live in ~/.local/bin, which a fresh login shell may not have in PATH yet.
PATH="$HOME/.local/bin:$PATH"
export PATH

usage() {
	cat <<TXT
usage: lilith-rice <command>

  install     deps, services, bluetooth, fonts, wallpapers, source, config, build, strata, zen, zed, verify
  deps        update the system, install packages, Intel microcode
  packages    check that every package name exists in the Void repos (installs nothing)
  services    enable runit services (dbus, elogind, bluetoothd, tlp, thermald)
  bluetooth   Bluetooth group + rfkill (the bluez package and service come with deps/services)
  fonts       install Gallant Raster Term, JetBrains Mono, Space Grotesk, Symbols Nerd Font, Terminus
  source      fetch or update the lilith compositor source
  config      link dotfiles, install /etc files, wire audio, set zsh, copy lilith config
  build       compile lilith and install it to ~/.local/bin
  wallpapers  download the wallpapers listed in wallpapers/wallhaven.txt
  strata      install the Strata GUI file manager (verified release binary)
  zen         install the Zen browser (official tarball)
  zed         install the Zed editor (official tarball)
  network     LAST STEP: switch Wi-Fi from wpa_supplicant/dhcpcd to NetworkManager
  theme       re-apply the palette (bin/lilith-theme)
  verify      check that everything is in place (exit 1 if not)
  update      git pull this repo, then source + config + build + verify

environment:  LILITH_SRC (default ~/.local/src/lilith)   DRY=1 (dry run)
TXT
}

# ---------------------------------------------------------------- 2. helpers
if [ -t 1 ]; then
	B='\033[1m'; G='\033[32m'; Y='\033[33m'; R='\033[31m'; Z='\033[0m'
else
	B=''; G=''; Y=''; R=''; Z=''
fi

step() { printf "\n${B}==> %s${Z}\n" "$*"; }
ok()   { printf "  ${G}ok${Z}    %s\n" "$*"; }
warn() { printf "  ${Y}warn${Z}  %s\n" "$*"; }
bad()  { printf "  ${R}FAIL${Z}  %s\n" "$*"; PROBLEMS=$((PROBLEMS + 1)); }
die()  { printf "${R}lilith-rice: %s${Z}\n" "$*" >&2; exit 1; }

# list_items <file>: the entries of a list file, without comments or blanks
list_items() {
	sed 's/#.*//; s/^[[:space:]]*//; s/[[:space:]]*$//; /^$/d' "$1"
}

# run_root <cmd...>: run with sudo/doas (or print it when DRY=1)
run_root() {
	if [ "$DRY" = 1 ]; then
		echo "  [dry] $*"
	elif [ "$(id -u)" = 0 ]; then
		"$@"
	elif command -v sudo >/dev/null 2>&1; then
		sudo "$@"
	elif command -v doas >/dev/null 2>&1; then
		doas "$@"
	else
		die "need root: install sudo or doas, or run as root"
	fi
}

# expect <bad|warn> <label> <hint> <command...>: print ok, or the hint on failure
expect() {
	level=$1; label=$2; hint=$3; shift 3
	if "$@" >/dev/null 2>&1; then
		ok "$label"
	elif [ "$level" = warn ]; then
		warn "$label: $hint"
	else
		bad "$label: $hint"
	fi
}

in_group()       { id -nG "$USER" | tr ' ' '\n' | grep -qx "$1"; }
login_shell()    { getent passwd "$USER" | cut -d: -f7; }
has_wallpapers() { ls "$WALLPAPERS"/wallhaven-* >/dev/null 2>&1; }

if [ "$(id -u)" = 0 ] && [ "${ALLOW_ROOT:-0}" != 1 ]; then
	die "run as your normal user (it uses sudo only where needed)"
fi

# soft <function> <hint>: a failure inside <function> only warns, it never fails the install
soft() {
	before=$PROBLEMS
	"$1"
	if [ "$PROBLEMS" -gt "$before" ]; then
		PROBLEMS=$before
		warn "$2"
	fi
}

# fetch <url> <file>: download, following redirects; fails on HTTP errors.
fetch() { curl -fsSL -o "$2" "$1"; }

# fetch_checked <url> <sha256> <file>: download and verify; a mismatching file is deleted.
fetch_checked() {
	fetch "$1" "$3" || return 1
	[ "$(sha256sum "$3" | cut -d' ' -f1)" = "$2" ] || { rm -f "$3"; return 1; }
}

fc_has() { fc-list 2>/dev/null | grep -qiF "$1"; }

# ---------------------------------------------------------------- 3. packages
# install_packages <list file> <required|optional>
install_packages() {
	failed=""
	for p in $(list_items "$1"); do
		if xbps-query "$p" >/dev/null 2>&1; then
			[ "$2" = required ] && ok "$p (already installed)"
		elif run_root xbps-install -y "$p" >/dev/null 2>&1 || [ "$DRY" = 1 ]; then
			ok "$p"
		elif [ "$2" = required ]; then
			bad "$p"
			failed="$failed $p"
		else
			warn "optional package not installed: $p"
		fi
	done
	if [ -n "$failed" ]; then
		printf '\n  Missing required packages:%s\n' "$failed"
		printf '  Find the right name:  xbps-query -Rs <word>\n'
		printf '  Fix packages/void-required.txt, then run: lilith-rice deps\n'
	fi
}

# Intel CPU microcode lives in the nonfree repo: optional, never fatal.
# The nonfree repository (Intel microcode and some firmware live there).
enable_nonfree() {
	if xbps-query void-repo-nonfree >/dev/null 2>&1; then
		ok "void-repo-nonfree (already enabled)"
	elif run_root xbps-install -y void-repo-nonfree >/dev/null 2>&1 && run_root xbps-install -Sy >/dev/null 2>&1; then
		ok "void-repo-nonfree enabled"
	else
		warn "could not enable void-repo-nonfree"
	fi
}

install_ucode() {
	if xbps-query intel-ucode >/dev/null 2>&1; then
		ok "intel-ucode (already installed)"
	elif run_root xbps-install -y intel-ucode >/dev/null 2>&1; then
		ok "intel-ucode (rebuilding initramfs, this takes a minute)"
		run_root xbps-reconfigure -fa >/dev/null 2>&1 || warn "initramfs rebuild reported a problem"
	else
		warn "intel-ucode not installed (optional)"
	fi
}

cmd_deps() {
	step "Packages (xbps)"
	if [ "$DRY" != 1 ] && ! command -v xbps-install >/dev/null 2>&1; then
		die "xbps-install not found: this is meant for Void Linux"
	fi
	# xbps itself must be current before anything else.
	run_root xbps-install -Sy >/dev/null 2>&1 || run_root xbps-install -yu xbps \
		|| die "could not sync the package repositories (network?)"
	# Void does not support partial upgrades: bring the system current first.
	run_root xbps-install -Syu || die "system update failed"
	enable_nonfree
	install_packages "$RICE_HOME/packages/void-required.txt" required
	install_packages "$RICE_HOME/packages/void-optional.txt" optional
	install_ucode
}

# Pre-flight: does every package name exist in the Void repositories?
cmd_packages() {
	step "Package names (checks the Void repos, installs nothing)"
	if ! command -v xbps-query >/dev/null 2>&1; then
		die "xbps-query not found: this is meant for Void Linux"
	fi
	run_root xbps-install -S >/dev/null 2>&1 || warn "could not sync the repositories; results may be stale"
	for list in void-required void-strata void-zen void-optional; do
		for p in $(list_items "$RICE_HOME/packages/$list.txt"); do
			if xbps-query -R "$p" >/dev/null 2>&1; then
				ok "$p"
			elif [ "$list" = void-required ]; then
				bad "$p (in $list.txt): not found, check with: xbps-query -Rs ${p%%-*}"
			else
				warn "$p (in $list.txt): not found"
			fi
		done
	done
}

# ---------------------------------------------------------------- 4. services
cmd_services() {
	step "Services (runit)"
	for s in $(list_items "$RICE_HOME/packages/services.txt"); do
		if [ ! -d "/etc/sv/$s" ]; then
			bad "service '$s' does not exist in /etc/sv (package missing?)"
		elif [ -e "/var/service/$s" ]; then
			ok "$s (already enabled)"
		elif run_root ln -s "/etc/sv/$s" "/var/service/$s"; then
			ok "$s enabled"
		else
			bad "could not enable $s"
		fi
	done
}

# ---------------------------------------------------------------- 5. network
# Deliberately separate and last: it drops your Wi-Fi for a moment.
cmd_network() {
	step "Switch Wi-Fi to NetworkManager"
	cat <<TXT
  This disconnects you from Wi-Fi for a moment.
  The wpa_supplicant and dhcpcd SERVICES are turned off (the packages stay:
  NetworkManager uses wpa_supplicant as its Wi-Fi backend), then NetworkManager is turned on.
  Afterwards run  nmtui  -> "Activate a connection" and enter your Wi-Fi password again.
TXT
	if [ "$DRY" != 1 ]; then
		printf '  Continue? [y/N] '
		read -r answer
		case "$answer" in y|Y|yes) ;; *) echo "  cancelled."; return 0 ;; esac
	fi
	if [ ! -d /etc/sv/NetworkManager ]; then
		bad "NetworkManager is not installed (run: lilith-rice deps)"
		return
	fi
	for s in wpa_supplicant dhcpcd; do
		if [ -e "/var/service/$s" ] && run_root rm -f "/var/service/$s"; then
			ok "disabled $s"
		fi
	done
	if [ -e /var/service/NetworkManager ]; then
		ok "NetworkManager already enabled"
	elif run_root ln -s /etc/sv/NetworkManager /var/service/NetworkManager; then
		ok "NetworkManager enabled"
	else
		bad "could not enable NetworkManager"
	fi
	echo "  Now run:  nmtui"
}

# ---------------------------------------------------------------- 6. wallpapers
cmd_wallpapers() {
	step "Wallpapers -> $WALLPAPERS"
	if ! command -v curl >/dev/null 2>&1; then
		bad "curl not installed (sudo xbps-install curl)"
		return
	fi
	mkdir -p "$WALLPAPERS"
	for id in $(list_items "$RICE_HOME/wallpapers/wallhaven.txt"); do
		if ls "$WALLPAPERS"/wallhaven-"$id".* >/dev/null 2>&1; then
			ok "$id (already there)"
			continue
		fi
		prefix=$(printf '%s' "$id" | cut -c1-2)
		got=0
		for ext in jpg png; do
			url="https://w.wallhaven.cc/full/$prefix/wallhaven-$id.$ext"
			if curl -fsSL -o "$WALLPAPERS/wallhaven-$id.$ext" "$url"; then
				got=1
				break
			fi
			rm -f "$WALLPAPERS/wallhaven-$id.$ext"
		done
		if [ "$got" = 1 ]; then ok "$id"; else bad "could not download wallhaven $id"; fi
	done
}

# ---------------------------------------------------------------- 6b. fonts
# One folder of font files in your home, no root needed. Gallant and JetBrains Mono are
# verified against a pinned SHA-256; Space Grotesk and the icon font are plain HTTPS downloads.
cmd_fonts() {
	step "Fonts ($FONT_DIR)"
	for c in curl unzip tar fc-cache; do
		command -v "$c" >/dev/null 2>&1 || { bad "$c is not installed (run: lilith-rice deps)"; return; }
	done
	mkdir -p "$FONT_DIR"
	tmp=$(mktemp -d)

	if [ -f "$FONT_DIR/gallant.ttf" ]; then
		ok "Gallant Raster Term (already installed)"
	elif fetch_checked "$GALLANT_URL" "$GALLANT_SHA" "$tmp/gallant.tar.gz" \
	     && tar -xzf "$tmp/gallant.tar.gz" -C "$tmp" \
	     && src=$(find "$tmp" -name gallant.ttf | head -n1) && [ -n "$src" ] \
	     && install -Dm644 "$src" "$FONT_DIR/gallant.ttf"; then
		ok "Gallant (checksum verified)"
	else
		bad "Gallant: download or checksum failed"
	fi

	if ls "$FONT_DIR"/JetBrainsMono-*.ttf >/dev/null 2>&1; then
		ok "JetBrains Mono (already installed)"
	elif fetch_checked "$JETBRAINS_URL" "$JETBRAINS_SHA" "$tmp/jb.zip" && unzip -q -o "$tmp/jb.zip" -d "$tmp/jb"; then
		for style in Regular Bold Italic BoldItalic; do
			f=$(find "$tmp/jb" -name "JetBrainsMono-$style.ttf" | head -n1)
			[ -n "$f" ] && install -Dm644 "$f" "$FONT_DIR/JetBrainsMono-$style.ttf"
		done
		ok "JetBrains Mono (checksum verified)"
	else
		bad "JetBrains Mono: download or checksum failed"
	fi

	if ls "$FONT_DIR"/SpaceGrotesk* >/dev/null 2>&1; then
		ok "Space Grotesk (already installed)"
	elif fetch "$GROTESK_URL" "$tmp/sg.zip" && unzip -q -o "$tmp/sg.zip" -d "$tmp/sg"; then
		find "$tmp/sg" -name '*.ttf' -exec cp {} "$FONT_DIR/" \;
		ok "Space Grotesk"
	else
		warn "Space Grotesk could not be downloaded (optional)"
	fi

	if ls "$FONT_DIR"/SymbolsNerdFont-Regular.ttf >/dev/null 2>&1; then
		ok "Symbols Nerd Font (already installed)"
	elif fetch "$NERD_URL" "$tmp/nerd.zip" && unzip -q -o "$tmp/nerd.zip" -d "$tmp/nerd" \
	     && f=$(find "$tmp/nerd" -name 'SymbolsNerdFont-Regular.ttf' | head -n1) && [ -n "$f" ]; then
		install -Dm644 "$f" "$FONT_DIR/SymbolsNerdFont-Regular.ttf"
		ok "Symbols Nerd Font (bar icons)"
	else
		warn "Symbols Nerd Font could not be downloaded: the bar icons will show as boxes"
	fi
	rm -rf "$tmp"
	fc-cache -f >/dev/null 2>&1
	expect warn "Terminus" "package terminus-font is missing (lilith-rice deps)" fc_has "Terminus"
}

# If the Gallant file calls itself something else than palette.conf's font, use its real name.
reconcile_font() {
	[ -f "$FONT_DIR/gallant.ttf" ] || return 0
	want=$(sed -n 's/^font="\(.*\)"$/\1/p' "$CONF/lilith-rice/palette.conf" | head -n1)
	[ "$want" = "Gallant Raster Term" ] || return 0
	fc_has "$want" && return 0
	have=$(fc-scan --format '%{family}\n' "$FONT_DIR/gallant.ttf" 2>/dev/null | head -n1 | sed 's/,.*//')
	[ -n "$have" ] || return 0
	sed -i "s|^font=.*|font=\"$have\"|" "$CONF/lilith-rice/palette.conf"
	warn "the Gallant file calls itself '$have'; palette.conf now uses that name"
}

# ---------------------------------------------------------------- 6c. Zen browser, Zed editor
# Neither is in Void's repositories. Both are official tarballs unpacked in your home.
cmd_zen() {
	step "Zen Browser"
	if [ "$(uname -m)" != x86_64 ]; then bad "no prebuilt Zen for $(uname -m)"; return; fi
	install_packages "$RICE_HOME/packages/void-zen.txt" optional
	if [ -x "$HOME/.local/opt/zen/zen" ]; then ok "zen already installed (it updates itself)"; return; fi
	command -v curl >/dev/null 2>&1 || { bad "curl is not installed"; return; }
	tmp=$(mktemp -d)
	if ! fetch "$ZEN_URL" "$tmp/zen.tar.xz" || ! tar -xJf "$tmp/zen.tar.xz" -C "$tmp" || [ ! -x "$tmp/zen/zen" ]; then
		bad "could not download or unpack Zen"; rm -rf "$tmp"; return
	fi
	rm -rf "$HOME/.local/opt/zen"
	mkdir -p "$HOME/.local/opt" "$HOME/.local/share/applications"
	mv "$tmp/zen" "$HOME/.local/opt/zen"
	ln -sf "$HOME/.local/opt/zen/zen" "$HOME/.local/bin/zen"
	cat > "$HOME/.local/share/applications/zen.desktop" <<DESK
[Desktop Entry]
Name=Zen Browser
Exec=$HOME/.local/opt/zen/zen %u
Type=Application
Categories=Network;WebBrowser;
StartupWMClass=zen
DESK
	rm -rf "$tmp"
	ok "zen installed to ~/.local/opt/zen (official tarball over HTTPS; no checksum is published)"
}

cmd_zed() {
	step "Zed editor"
	if [ "$(uname -m)" != x86_64 ]; then bad "no prebuilt Zed for $(uname -m)"; return; fi
	if [ -x "$HOME/.local/zed.app/bin/zed" ]; then ok "zed already installed (it updates itself)"; return; fi
	command -v curl >/dev/null 2>&1 || { bad "curl is not installed"; return; }
	tmp=$(mktemp -d)
	if ! fetch "$ZED_URL" "$tmp/zed.tar.gz" || ! tar -xzf "$tmp/zed.tar.gz" -C "$HOME/.local" || [ ! -x "$HOME/.local/zed.app/bin/zed" ]; then
		bad "could not download or unpack Zed"; rm -rf "$tmp"; return
	fi
	ln -sf "$HOME/.local/zed.app/bin/zed" "$HOME/.local/bin/zed"
	# Desktop entry, exactly as the Zed docs describe.
	app="$HOME/.local/zed.app/share/applications/dev.zed.Zed.desktop"
	if [ -f "$app" ]; then
		install -D "$app" -t "$HOME/.local/share/applications"
		sed -i "s|Icon=zed|Icon=$HOME/.local/zed.app/share/icons/hicolor/512x512/apps/zed.png|g; s|Exec=zed|Exec=$HOME/.local/zed.app/bin/zed|g" \
			"$HOME/.local/share/applications/dev.zed.Zed.desktop"
	fi
	rm -rf "$tmp"
	ok "zed installed to ~/.local/zed.app (official tarball over HTTPS; needs Vulkan: mesa-vulkan-intel)"
}

# ---------------------------------------------------------------- 6d. Bluetooth
# The bluez package and the bluetoothd service come with deps / services; this wires the user.
cmd_bluetooth() {
	step "Bluetooth"
	if ! getent group bluetooth >/dev/null 2>&1; then
		warn "group 'bluetooth' does not exist yet (is bluez installed? run: lilith-rice deps)"
	elif in_group bluetooth; then
		ok "$USER is in the bluetooth group"
	elif run_root usermod -aG bluetooth "$USER"; then
		ok "added $USER to the bluetooth group (log out and in to apply)"
	else
		bad "could not add $USER to the bluetooth group"
	fi
	# A radio that is soft-blocked would look like a driver problem.
	if command -v rfkill >/dev/null 2>&1; then
		run_root rfkill unblock bluetooth && ok "bluetooth radio unblocked"
	fi
}

# ---------------------------------------------------------------- 7. Strata
# Strata publishes a verified binary for glibc Linux. We follow its README:
# download the release archive + its .sha256, check it, install to ~/.local/bin.
cmd_strata() {
	step "Strata (GUI file manager)"
	if [ "$(uname -m)" != x86_64 ]; then
		bad "no prebuilt Strata for $(uname -m)"
		return
	fi
	glibc=$(getconf GNU_LIBC_VERSION 2>/dev/null | awk '{print $2}')
	if [ -z "$glibc" ] || [ "$(printf '%s\n2.39\n' "$glibc" | sort -V | head -n1)" != 2.39 ]; then
		bad "Strata needs glibc 2.39 or newer (found: ${glibc:-none})"
		return
	fi
	ok "glibc $glibc"
	install_packages "$RICE_HOME/packages/void-strata.txt" optional
	if command -v strata >/dev/null 2>&1; then
		ok "strata already installed (it updates itself: Settings > Updates)"
		return
	fi
	if ! command -v curl >/dev/null 2>&1; then
		bad "curl not installed"
		return
	fi
	tmp=$(mktemp -d)
	url=$(curl -fsSL "$STRATA_API" 2>/dev/null \
	      | sed -n 's/.*"browser_download_url": *"\([^"]*x86_64-unknown-linux-gnu\.tar\.gz\)".*/\1/p' | head -n1)
	if [ -z "$url" ]; then
		bad "could not find the Strata release (network, or GitHub API limit); see the README for manual steps"
		rm -rf "$tmp"
		return
	fi
	archive=$(basename "$url")
	if ! ( cd "$tmp" \
	       && curl -fsSLO "$url" && curl -fsSLO "$url.sha256" \
	       && sha256sum -c "$archive.sha256" >/dev/null 2>&1 \
	       && tar -xzf "$archive" ); then
		bad "download or SHA-256 verification failed; nothing was installed"
		rm -rf "$tmp"
		return
	fi
	dir="$tmp/${archive%.tar.gz}"
	if install -Dm755 "$dir/strata" "$HOME/.local/bin/strata"; then
		ok "strata installed to ~/.local/bin/strata (checksum verified)"
	else
		bad "could not install the strata binary"
	fi
	icons="$HOME/.local/share/icons/hicolor/scalable/apps"
	apps="$HOME/.local/share/applications"
	if [ -f "$dir/io.github.lgse.Strata.svg" ] && [ -f "$dir/io.github.lgse.Strata.desktop" ]; then
		install -Dm644 "$dir/io.github.lgse.Strata.svg" "$icons/io.github.lgse.Strata.svg"
		mkdir -p "$apps"
		sed "s|^Exec=strata |Exec=$HOME/.local/bin/strata |" "$dir/io.github.lgse.Strata.desktop" \
			> "$apps/io.github.lgse.Strata.desktop"
		command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database "$apps" 2>/dev/null
		ok "desktop entry + icon"
	else
		warn "desktop entry / icon not found in the archive (Strata still works)"
	fi
	rm -rf "$tmp"
}

# ---------------------------------------------------------------- 8. source, config, build
cmd_source() {
	step "lilith source ($LILITH_SRC)"
	if ! command -v git >/dev/null 2>&1; then
		bad "git not installed"
		return
	fi
	if [ -d "$LILITH_SRC/.git" ]; then
		if git -C "$LILITH_SRC" fetch -q origin \
		   && { git -C "$LILITH_SRC" reset -q --hard origin/HEAD 2>/dev/null \
		        || git -C "$LILITH_SRC" reset -q --hard origin/main; }; then
			ok "updated"
		else
			bad "could not update the source"
		fi
	else
		mkdir -p "$(dirname "$LILITH_SRC")"
		if git clone -q "$LILITH_URL" "$LILITH_SRC"; then
			ok "cloned $LILITH_URL"
		else
			bad "clone failed (network?)"
		fi
	fi
}

# backup_then <path>: move an existing file out of the way
backup_then() {
	[ -e "$1" ] || [ -L "$1" ] || return 0
	mkdir -p "$BACKUP/$(dirname "${1#"$HOME"/}")"
	mv "$1" "$BACKUP/${1#"$HOME"/}" && warn "backed up $1 -> $BACKUP/"
}

# link <repo file> <destination>
link() {
	if [ -L "$2" ] && [ "$(readlink "$2")" = "$1" ]; then
		ok "$2"
		return
	fi
	mkdir -p "$(dirname "$2")"
	backup_then "$2"
	if ln -s "$1" "$2"; then ok "$2 -> repo"; else bad "could not link $2"; fi
}

config_dotfiles() {
	step "Dotfiles"
	# Exec bits can be lost when files travel (zip, phone, ...).
	chmod +x "$RICE_HOME/lilith-rice" "$RICE_HOME"/bin/* 2>/dev/null
	mkdir -p "$HOME/.local/bin" "$CONF/lilith-rice"
	link "$RICE_HOME/lilith-rice" "$HOME/.local/bin/lilith-rice"
	for f in "$RICE_HOME"/bin/*; do
		link "$f" "$HOME/.local/bin/$(basename "$f")"
	done
	link "$RICE_HOME/config/foot/foot.ini"         "$CONF/foot/foot.ini"
	link "$RICE_HOME/config/yazi/yazi.toml"        "$CONF/yazi/yazi.toml"
	link "$RICE_HOME/config/fontconfig/fonts.conf" "$CONF/fontconfig/fonts.conf"
	link "$RICE_HOME/config/fastfetch/config.jsonc" "$CONF/fastfetch/config.jsonc"
	link "$RICE_HOME/config/gtk-3.0/settings.ini"  "$CONF/gtk-3.0/settings.ini"
	link "$RICE_HOME/config/gtk-4.0/settings.ini"  "$CONF/gtk-4.0/settings.ini"
	link "$RICE_HOME/config/zed/settings.json"     "$CONF/zed/settings.json"
	link "$RICE_HOME/config/zsh/zshrc"             "$HOME/.zshrc"
	link "$RICE_HOME/config/zsh/zprofile"          "$HOME/.zprofile"
	if [ ! -f "$CONF/lilith-rice/palette.conf" ]; then
		cp "$RICE_HOME/theme/palette.conf" "$CONF/lilith-rice/palette.conf"
	fi
	reconcile_font
	ok "palette: $CONF/lilith-rice/palette.conf"
	printf '%s\n' "$RICE_HOME" > "$CONF/lilith-rice/home"
	command -v fc-cache >/dev/null 2>&1 && fc-cache -f >/dev/null 2>&1
}

config_system() {
	step "System files (/etc)"
	for f in $(cd "$RICE_HOME/system" && find . -type f | sed 's|^\./||'); do
		if [ -f "/$f" ] && cmp -s "$RICE_HOME/system/$f" "/$f"; then
			ok "/$f"
		elif run_root install -Dm644 "$RICE_HOME/system/$f" "/$f"; then
			ok "/$f installed"
		else
			bad "could not install /$f"
		fi
	done
}

# The power menu runs zzz / reboot / poweroff through sudo without a password prompt,
# only for members of wheel and only for those three commands. The rule is validated first.
config_power() {
	step "Power menu permissions"
	if ! command -v visudo >/dev/null 2>&1; then
		warn "visudo not found; the power menu will fall back to loginctl"
		return
	fi
	cmds=""
	for c in zzz reboot poweroff; do
		path=$(command -v "$c" 2>/dev/null) || continue
		real=$(readlink -f "$path")
		cmds="$cmds${cmds:+, }$path"
		[ "$real" != "$path" ] && cmds="$cmds, $real"
	done
	[ -n "$cmds" ] || { warn "zzz/reboot/poweroff not found"; return; }
	tmp=$(mktemp)
	printf '# lilith-rice: the power menu may suspend, reboot and power off without a password\n%%wheel ALL=(root) NOPASSWD: %s\n' "$cmds" > "$tmp"
	if run_root visudo -cf "$tmp" >/dev/null 2>&1; then
		if [ -f /etc/sudoers.d/10-lilith-power ] && cmp -s "$tmp" /etc/sudoers.d/10-lilith-power; then
			ok "/etc/sudoers.d/10-lilith-power"
		elif run_root install -m 0440 -o root -g root "$tmp" /etc/sudoers.d/10-lilith-power; then
			ok "/etc/sudoers.d/10-lilith-power installed"
		else
			bad "could not install the sudoers rule"
		fi
	else
		warn "the generated sudoers rule did not validate; skipped"
	fi
	rm -f "$tmp"
}

# PipeWire as the Void handbook describes: pipewire launches wireplumber and
# pipewire-pulse itself (right order), and ALSA apps are routed through it.
config_audio() {
	step "Audio (PipeWire)"
	pw=/etc/pipewire/pipewire.conf.d
	alsa=/etc/alsa/conf.d
	run_root mkdir -p "$pw" "$alsa"
	for pair in \
	  "/usr/share/examples/wireplumber/10-wireplumber.conf $pw/10-wireplumber.conf" \
	  "/usr/share/examples/pipewire/20-pipewire-pulse.conf $pw/20-pipewire-pulse.conf" \
	  "/usr/share/alsa/alsa.conf.d/50-pipewire.conf $alsa/50-pipewire.conf" \
	  "/usr/share/alsa/alsa.conf.d/99-pipewire-default.conf $alsa/99-pipewire-default.conf"
	do
		set -- $pair
		if [ -L "$2" ] || [ -e "$2" ]; then
			ok "$2"
		elif [ "$DRY" != 1 ] && [ ! -e "$1" ]; then
			warn "$1 missing (are pipewire and alsa-pipewire installed?)"
		elif run_root ln -s "$1" "$2"; then
			ok "$2 linked"
		else
			bad "could not link $2"
		fi
	done
}

config_shell() {
	step "Login shell"
	zsh_path=$(command -v zsh || true)
	if [ -z "$zsh_path" ]; then
		warn "zsh not installed yet"
	elif [ "$(login_shell)" = "$zsh_path" ]; then
		ok "zsh is your login shell"
	elif run_root usermod -s "$zsh_path" "$USER"; then
		ok "login shell set to $zsh_path"
	else
		bad "could not change login shell"
	fi
}

config_lilith() {
	step "lilith configuration"
	if [ ! -d "$LILITH_SRC" ]; then
		bad "lilith source missing: run 'lilith-rice source'"
	else
		mkdir -p "$LILITH_SRC/config"
		if cp -f "$RICE_HOME/lilith/config.h" "$LILITH_SRC/config.h" \
		   && cp -f "$RICE_HOME"/lilith/config/*.h "$LILITH_SRC/config/"; then
			ok "config copied into $LILITH_SRC"
		else
			bad "could not copy lilith config"
		fi
	fi
	# Always generate the palette outputs: foot.ini includes colors.ini, which must exist.
	"$RICE_HOME/bin/lilith-theme" --no-build || bad "theme generation failed"
}

cmd_config() {
	config_dotfiles
	config_system
	config_power
	config_audio
	config_shell
	config_lilith
}

cmd_build() {
	step "Build lilith"
	if [ ! -d "$LILITH_SRC" ]; then
		bad "source missing: run 'lilith-rice source'"
		return
	fi
	if ! pkg-config --exists wlroots-0.19 2>/dev/null; then
		bad "wlroots-0.19 development files not found (package: wlroots0.19-devel)"
		return
	fi
	"$RICE_HOME/bin/lilith-theme" --no-build >/dev/null 2>&1
	if make -C "$LILITH_SRC" >"$LILITH_SRC/build.log" 2>&1; then
		install -Dm755 "$LILITH_SRC/lilith" "$HOME/.local/bin/lilith"
		ok "lilith installed to ~/.local/bin/lilith"
	else
		bad "build failed; last lines of $LILITH_SRC/build.log:"
		tail -n 15 "$LILITH_SRC/build.log" | sed 's/^/        /'
	fi
}

# ---------------------------------------------------------------- 9. verify
cmd_verify() {
	step "Verify"
	for c in lilith lilith-session lilith-menu lilith-status lilith-theme lilith-shot lilith-record \
	         foot zsh yazi fzf fastfetch wmenu wpctl brightnessctl grim slurp wf-recorder wl-copy cliphist \
	         nmtui nmcli bluetoothctl dbus-run-session pipewire curl; do
		expect bad "$c" "command not found" command -v "$c"
	done
	for s in $(list_items "$RICE_HOME/packages/services.txt"); do
		if [ ! -e "/var/service/$s" ]; then
			bad "service $s: not enabled"
		elif sv status "/var/service/$s" 2>/dev/null | grep -q '^run:'; then
			ok "service $s: running"
		else
			warn "service $s: enabled, not running yet"
		fi
	done
	expect warn "NetworkManager enabled" "run 'lilith-rice network' as the last step" \
		test -e /var/service/NetworkManager
	for g in video network bluetooth; do
		expect warn "group $g" "log out and in, or add yourself" in_group "$g"
	done
	if [ -e /var/service/acpid ]; then
		warn "acpid is enabled but elogind handles lid/power (turn it off: sudo rm /var/service/acpid)"
	fi
	expect bad "elogind lid/power config" "run 'lilith-rice config'" \
		test -f /etc/elogind/logind.conf.d/10-lilith.conf
	expect bad "PipeWire launches wireplumber" "run 'lilith-rice config'" \
		test -L /etc/pipewire/pipewire.conf.d/10-wireplumber.conf
	expect bad "PipeWire launches pipewire-pulse" "run 'lilith-rice config'" \
		test -L /etc/pipewire/pipewire.conf.d/20-pipewire-pulse.conf
	expect bad "ALSA routed through PipeWire" "run 'lilith-rice config'" \
		test -L /etc/alsa/conf.d/50-pipewire.conf
	expect warn "strata" "run 'lilith-rice strata'" command -v strata
	expect warn "zen" "run 'lilith-rice zen'" command -v zen
	expect warn "zed" "run 'lilith-rice zed'" command -v zed
	for fam in "Gallant" "JetBrains Mono" "Space Grotesk" "Terminus" "Symbols Nerd Font"; do
		expect warn "font $fam" "run 'lilith-rice fonts'" fc_has "$fam"
	done
	expect warn "fastfetch config" "check $CONF/fastfetch/config.jsonc" fastfetch --config "$CONF/fastfetch/config.jsonc"
	expect warn "power menu rule" "run 'lilith-rice config'" test -f /etc/sudoers.d/10-lilith-power
	expect warn "wallpapers in ~/Pictures/Wallpapers" "run 'lilith-rice wallpapers'" has_wallpapers
	expect bad "palette" "missing palette.conf" test -f "$CONF/lilith-rice/palette.conf"
	expect bad "foot colours" "run 'lilith-theme'" test -f "$CONF/foot/colors.ini"
	expect bad "monospace font" "fontconfig has no monospace font" fc-match monospace
	expect warn "login shell is zsh" "run 'lilith-rice config'" \
		test "$(login_shell)" = "$(command -v zsh || echo none)"
	if [ -n "${XDG_RUNTIME_DIR:-}" ]; then
		ok "XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR"
	else
		warn "XDG_RUNTIME_DIR unset (normal outside a tty login; check again on tty1)"
	fi
	printf '\n'
	if [ "$PROBLEMS" -eq 0 ]; then
		printf "${G}${B}all checks passed${Z}\n"
	else
		printf "${R}${B}%s problem(s) found${Z}\n" "$PROBLEMS"
	fi
	[ "$PROBLEMS" -eq 0 ]
}

# ---------------------------------------------------------------- 10. install / update
cmd_install() {
	cmd_deps
	cmd_services
	cmd_bluetooth
	soft cmd_fonts "some fonts failed; retry later with: lilith-rice fonts"
	soft cmd_wallpapers "some wallpapers failed; retry later with: lilith-rice wallpapers"
	cmd_source
	cmd_config
	cmd_build
	soft cmd_strata "Strata was not installed; retry later with: lilith-rice strata"
	soft cmd_zen "Zen was not installed; retry later with: lilith-rice zen"
	soft cmd_zed "Zed was not installed; retry later with: lilith-rice zed"
	cmd_verify
	rc=$?
	cat <<MSG

${B}Next:${Z}
  1. lilith-rice network   (switches Wi-Fi to NetworkManager; then use nmtui)
  2. Reboot (so services, elogind and groups take effect).
  3. Log in on tty1: the desktop starts by itself.
  4. Super+/ shows every key binding.
MSG
	return $rc
}

cmd_update() {
	step "Update"
	git -C "$RICE_HOME" pull --ff-only || die "git pull failed (local changes?)"
	cmd_source
	cmd_config
	cmd_build
	cmd_verify
}

# ---------------------------------------------------------------- 11. dispatch
case "${1:-help}" in
	install)    cmd_install ;;
	deps)       cmd_deps ;;
	packages)   cmd_packages ;;
	services)   cmd_services ;;
	bluetooth)  cmd_bluetooth ;;
	fonts)      cmd_fonts ;;
	source)     cmd_source ;;
	config)     cmd_config ;;
	build)      cmd_build ;;
	wallpapers) cmd_wallpapers ;;
	strata)     cmd_strata ;;
	zen)        cmd_zen ;;
	zed)        cmd_zed ;;
	network)    cmd_network ;;
	theme)      exec "$RICE_HOME/bin/lilith-theme" ;;
	verify)     cmd_verify ;;
	update)     cmd_update ;;
	help|-h|--help) usage ;;
	*) usage >&2; exit 2 ;;
esac
