# ======================================================================
#  zprofile — login shell: PATH, and start the desktop on tty1
# ----------------------------------------------------------------------
#  Lives at ~/.zprofile (symlink to this file). The desktop starts on tty1 only.
# ======================================================================

export PATH="$HOME/.local/bin:$PATH"
export EDITOR=vi
if [ -z "${WAYLAND_DISPLAY:-}" ] && [ "${XDG_VTNR:-}" = "1" ]; then
	exec lilith-session
fi
