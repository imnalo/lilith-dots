// ======================================================================
//  config.jsonc — fastfetch: a short greeting with a Void logo (no wordmark)
// ----------------------------------------------------------------------
//  Lives at ~/.config/fastfetch/config.jsonc (symlink to this file).
//  Run by ~/.zshrc when a terminal opens. Colours follow the terminal palette ("green").
//  To add a line, add a module; list them with: fastfetch --list-modules
// ======================================================================
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "data",
    "source": "$1         ▄▄▄▄▄▄▄▄▄▄\n      ▄██████▀▀██████▄\n    ▄███▀          ▀███▄\n  ▄███▀▄▄          ▄▄▀███▄\n ▄██▀ ████        ████ ▀██▄\n ███   ████      ████   ███\n ██▀    ████▄  ▄████    ▀██\n ██▄     ████▄▄████     ▄██\n ███      ████████      ███\n ▀██▄      ▀████▀      ▄██▀\n  ▀███▄     ▀██▀     ▄███▀\n    ▀███▄          ▄███▀\n      ▀██████▄▄██████▀\n         ▀▀▀▀▀▀▀▀▀▀",
    "color": {
      "1": "green"
    },
    "padding": {
      "top": 1,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "green",
      "title": "green"
    }
  },
  "modules": [
    "title",
    "separator",
    {
      "type": "os",
      "key": "os"
    },
    {
      "type": "kernel",
      "key": "kernel"
    },
    {
      "type": "uptime",
      "key": "up"
    },
    {
      "type": "shell",
      "key": "shell"
    },
    {
      "type": "wm",
      "key": "wm"
    },
    {
      "type": "memory",
      "key": "mem"
    }
  ]
}
