#!/bin/sh
# ======================================================================
#  lilith-status — the text at the right end of the bar
# ----------------------------------------------------------------------
#  Prints  "lilith | Sat 07 Nov  19:20"  like vxwm-dotfiles' "vxwm | HH:MM", and a
#  bright red  REC  badge in front while lilith-record is recording.
#  lilith reads it from stdin (dwm-style status pipe), see lilith-session:
#      lilith-status | lilith
#  lilith-record sends USR1 on start and stop so the badge changes at once.
# ======================================================================

set -u

PALETTE="${XDG_CONFIG_HOME:-$HOME/.config}/lilith-rice/palette.conf"
dim=4a5350
# shellcheck disable=SC1090
[ -f "$PALETTE" ] && . "$PALETTE"

# recording: is a live wf-recorder around? (a finished-but-unreaped process does not count)
recording() {
	for pid in $(pgrep -x wf-recorder 2>/dev/null); do
		grep -q '^State:[[:space:]]*Z' "/proc/$pid/status" 2>/dev/null || return 0
	done
	return 1
}

emit() {
	badge=""
	recording && badge="^bg(ff2020)^fg(ffffff) REC ^d "
	printf '%s^fg(%s)lilith^d | %s\n' "$badge" "$dim" "$(date '+%a %d %b  %H:%M')"
}

trap : USR1        # a signal only wakes the loop; the next emit shows the new state

while :; do
	emit
	sleep 20 &
	pid=$!
	wait "$pid"
	kill "$pid" 2>/dev/null
done
