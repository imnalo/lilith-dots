#!/bin/sh
# ======================================================================
#  lilith-theme — apply ~/.config/lilith-rice/palette.conf everywhere
# ----------------------------------------------------------------------
#  usage: lilith-theme [--no-build]
#  Writes $LILITH_SRC/theme.h (compositor + bar), ~/.config/foot/colors.ini and
#  ~/.config/strata/themes/lilith.toml (colours + the font for foot and the bar), recolours open terminals live, then
#  rebuilds lilith unless --no-build is given.
#  Milestone 1: the compositor part needs a rebuild + session restart (Super+Shift+Q).
#  Milestone 2 patches lilith to reload colours at runtime.
# ======================================================================

set -eu

CONF="${XDG_CONFIG_HOME:-$HOME/.config}"
PALETTE="${PALETTE:-$CONF/lilith-rice/palette.conf}"
LILITH_SRC="${LILITH_SRC:-$HOME/.local/src/lilith}"
FOOT_COLORS="$CONF/foot/colors.ini"
BUILD=1
[ "${1:-}" = "--no-build" ] && BUILD=0

die() { printf 'lilith-theme: %s\n' "$*" >&2; exit 1; }

[ -f "$PALETTE" ] || die "palette not found: $PALETTE"
# shellcheck disable=SC1090
. "$PALETTE"

# --- validate: every colour must be exactly 6 hex digits ------------------
check() {
	case "$2" in
		[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]) ;;
		*) die "bad colour for '$1': '$2' (want 6 hex digits, no #)" ;;
	esac
}
for n in background foreground accent urgent dim \
         color0 color1 color2 color3 color4 color5 color6 color7 \
         color8 color9 color10 color11 color12 color13 color14 color15; do
	eval "v=\${$n:-}"
	[ -n "$v" ] || die "missing '$n' in $PALETTE"
	check "$n" "$v"
done
font="${font:-monospace}"
font_size="${font_size:-12}"
case "$font_size" in ''|*[!0-9]*) die "bad font_size '$font_size' in $PALETTE (want a whole number)" ;; esac
scale="${scale:-1}"
case "$scale" in
	[0-9] | [0-9].[0-9] | [0-9].[0-9][0-9]) ;;
	*) die "bad scale '$scale' in $PALETTE (want e.g. 1, 1.25, 1.5, 2)" ;;
esac
case "$scale" in *.*) ;; *) scale="$scale.0" ;; esac   # C wants 1.0f, not 1f
wallpaper="${wallpaper:-}"
# A wallpaper saved as .png when the palette says .jpg (or the reverse) is still found.
if [ -n "$wallpaper" ] && [ ! -f "$wallpaper" ]; then
	for ext in jpg jpeg png; do
		[ -f "${wallpaper%.*}.$ext" ] && { wallpaper="${wallpaper%.*}.$ext"; break; }
	done
fi
if [ -n "$wallpaper" ] && [ ! -f "$wallpaper" ]; then
	printf 'lilith-theme: wallpaper not found, ignoring: %s\n' "$wallpaper" >&2
	wallpaper=""
fi

# --- 1. compositor header --------------------------------------------------
# lilith's Makefile does not track theme.h, so touch config.h when it changes
# (otherwise `make` would keep the old colours).
if [ -d "$LILITH_SRC" ]; then
	tmp="$LILITH_SRC/theme.h.new"
	cat > "$tmp" <<HDR
/* Generated by lilith-theme from palette.conf. Do not edit. */
#ifndef LILITH_THEME_H
#define LILITH_THEME_H
#define T_BG        0x${background}ff
#define T_FG        0x${foreground}ff
#define T_ACCENT    0x${accent}ff
#define T_URGENT    0x${urgent}ff
#define T_DIM       0x${dim}ff
#define T_CLEAR     0x${background}00
#define T_ACCENT_A  0x${accent}70
#define T_WALLPAPER "${wallpaper}"
#define T_BAR_FONT  "${font}:size=${font_size}"
#define T_SCALE     ${scale}f
#endif
HDR
	if cmp -s "$tmp" "$LILITH_SRC/theme.h" 2>/dev/null; then
		rm -f "$tmp"
	else
		mv "$tmp" "$LILITH_SRC/theme.h"
		[ -f "$LILITH_SRC/config.h" ] && touch "$LILITH_SRC/config.h"
	fi
else
	printf 'lilith-theme: %s missing, skipping compositor header\n' "$LILITH_SRC" >&2
fi

# --- 2. foot colours --------------------------------------------------------
# Newer foot calls the section [colors-dark], older foot [colors]. Instead of
# guessing from a version number, ask foot itself (`foot --check-config`).
write_foot_colors() { # $1 = section name
	{
		printf '# Generated by lilith-theme from palette.conf. Do not edit.\n'
		printf '[main]\nfont=%s:size=%s, monospace:size=%s\n\n' "$font" "$font_size" "$font_size"
		printf '[%s]\n' "$1"
		printf 'background=%s\nforeground=%s\n' "$background" "$foreground"
		i=0
		while [ $i -le 7 ]; do
			eval "r=\$color$i; b=\$color$((i + 8))"
			printf 'regular%s=%s\nbright%s=%s\n' "$i" "$r" "$i" "$b"
			i=$((i + 1))
		done
	} > "$FOOT_COLORS"
}
mkdir -p "$(dirname "$FOOT_COLORS")"
write_foot_colors colors-dark
if command -v foot >/dev/null 2>&1 && ! foot --check-config >/dev/null 2>&1; then
	write_foot_colors colors
	foot --check-config >/dev/null 2>&1 || {
		write_foot_colors colors-dark
		printf 'lilith-theme: foot reports a config problem (run: foot --check-config)\n' >&2
	}
fi

# --- 2b. Strata theme --------------------------------------------------------
# Strata re-reads ~/.config/strata/themes/*.toml live. Select "lilith" once under
# Settings > Appearance > Your themes; afterwards it follows the palette.
mix() { # mix <from> <to> <percent>: the colour <percent>% of the way from -> to
	out=""
	for pos in 1-2 3-4 5-6; do
		a=$((0x$(printf %s "$1" | cut -c$pos)))
		b=$((0x$(printf %s "$2" | cut -c$pos)))
		out="$out$(printf '%02x' $(( a + (b - a) * $3 / 100 )))"
	done
	printf %s "$out"
}
STRATA_THEME="$CONF/strata/themes/lilith.toml"
mkdir -p "$(dirname "$STRATA_THEME")"
cat > "$STRATA_THEME" <<TOML
# Generated by lilith-theme from palette.conf. Do not edit.
name = "lilith"
background = "#${background}"
surface = "#$(mix "$background" "$foreground" 6)"
text = "#${foreground}"
accent = "#${accent}"
danger = "#${urgent}"
muted = "#$(mix "$background" "$foreground" 12)"
highlight = "#$(mix "$background" "$accent" 28)"
border = "#${dim}"
dim_text = "#$(mix "$background" "$foreground" 55)"
TOML

# --- 3. recolour open terminals live ----------------------------------------
seq_out() {
	printf '\033]10;#%s\007\033]11;#%s\007\033]12;#%s\007' "$foreground" "$background" "$accent"
	i=0
	while [ $i -le 15 ]; do
		eval "c=\$color$i"
		printf '\033]4;%s;#%s\007' "$i" "$c"
		i=$((i + 1))
	done
}
for pts in /dev/pts/[0-9]*; do
	[ -O "$pts" ] && [ -w "$pts" ] && seq_out > "$pts" 2>/dev/null || true
done

# --- 4. rebuild compositor ----------------------------------------------------
if [ "$BUILD" = 1 ] && [ -d "$LILITH_SRC" ]; then
	if make -C "$LILITH_SRC" >/dev/null 2>"$LILITH_SRC/build.log"; then
		install -Dm755 "$LILITH_SRC/lilith" "$HOME/.local/bin/lilith"
		echo "lilith-theme: compositor rebuilt. Restart the session (Super+Shift+Q) for new borders/bar colours."
	else
		echo "lilith-theme: BUILD FAILED, keeping the old binary. See $LILITH_SRC/build.log" >&2
		exit 1
	fi
fi
echo "lilith-theme: palette applied."
