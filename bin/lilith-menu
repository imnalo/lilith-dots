#!/bin/sh
# ======================================================================
#  lilith-menu — bar-style menus on the bottom edge (wmenu)
# ----------------------------------------------------------------------
#  usage: lilith-menu apps | clip | power | font | wall | wifi | bluetooth | cheat
#
#    apps       launcher: every program in your PATH
#    clip       clipboard history (cliphist)
#    power      one line: Exit  Suspend  Reboot  Poweroff   (no lock screen)
#    font       pick the font for the terminal, bar and menus
#    wall       pick a wallpaper from ~/Pictures/Wallpapers
#    wifi       Wi-Fi networks via NetworkManager
#    bluetooth  Bluetooth devices (needs: lilith-rice bluetooth)
#    cheat      searchable list of every key binding
#
#  Colours and font come from palette.conf, so the menus match the bar.
#  They span the bottom edge over the bar (wmenu). Menus that slide up at bar
#  width are on the roadmap; the commands and key bindings will stay the same.
# ======================================================================

set -u

CONF="${XDG_CONFIG_HOME:-$HOME/.config}"
PALETTE="$CONF/lilith-rice/palette.conf"

# ---------------------------------------------------------------- settings
background=101312 foreground=c9d1ce accent=7fcfc0 font=monospace font_size=12
# shellcheck disable=SC1090
[ -f "$PALETTE" ] && . "$PALETTE"

# ---------------------------------------------------------------- helpers
# fail <message>: menus are started from key bindings, so show errors in a window.
fail() {
	if command -v foot >/dev/null 2>&1; then
		foot -T lilith-menu -e sh -c 'printf "lilith-menu: %s\n\nPress Enter." "$1"; read -r _' sh "$1" &
	else
		echo "lilith-menu: $1" >&2
	fi
	exit 1
}

command -v wmenu >/dev/null 2>&1 || fail "wmenu is not installed (run: lilith-rice deps)"

# menu <prompt> [lines]: choices on stdin, the pick on stdout.
# No lines = one horizontal row (like the vxwm power menu); lines = a list growing upward.
menu() {
	_prompt=$1
	_lines=${2:-0}
	set -- -b -i -p "$_prompt" -f "$font $font_size" \
	       -N "$background" -n "$foreground" -S "$accent" -s "$background" -M "$accent" -m "$background"
	[ "$_lines" -gt 0 ] && set -- "$@" -l "$_lines"
	wmenu "$@"
}

# detach <command...>: start a program that outlives this script.
detach() { setsid -f "$@" >/dev/null 2>&1; }

# set_value <key> <value>: change one setting in palette.conf.
set_value() {
	if grep -q "^$1=" "$PALETTE"; then
		sed -i "s|^$1=.*|$1=\"$2\"|" "$PALETTE"
	else
		printf '%s="%s"\n' "$1" "$2" >> "$PALETTE"
	fi
}

# apply_theme: foot and Strata update at once; the bar needs a rebuild and a restart.
apply_theme() {
	lilith-theme --no-build >/dev/null 2>&1
	[ "$(printf 'Later\nRebuild the bar now\n' | menu "bar:")" = "Rebuild the bar now" ] || exit 0
	detach foot -T lilith-theme -e sh -c \
		'lilith-theme && echo && echo "Restart the session (Super+Shift+Q) to apply." ; echo; printf "Press Enter."; read -r _'
}

# ---------------------------------------------------------------- modes
mode_apps() {
	cmd=$( (IFS=:; for d in $PATH; do [ -d "$d" ] && ls -1 "$d" 2>/dev/null; done) | sort -u | menu "run:" 14) || exit 0
	[ -n "$cmd" ] && detach sh -c "exec $cmd"
}

mode_clip() {
	command -v cliphist >/dev/null 2>&1 || fail "cliphist is not installed"
	sel=$(cliphist list | menu "clip:" 10) || exit 0
	[ -n "$sel" ] && printf '%s' "$sel" | cliphist decode | wl-copy
}

mode_power() {
	choice=$(printf 'Exit\nSuspend\nReboot\nPoweroff\n' | menu "power:") || exit 0
	case "$choice" in
		Exit)     pkill -x lilith ;;
		Suspend)  sudo -n zzz      2>/dev/null || loginctl suspend ;;
		Reboot)   sudo -n reboot   2>/dev/null || loginctl reboot ;;
		Poweroff) sudo -n poweroff 2>/dev/null || loginctl poweroff ;;
	esac
}

mode_font() {
	families=$( { fc-list :spacing=100 family
	              fc-list -f '%{family}\n' | grep -iE '^(gallant|terminus|jetbrains)'; } 2>/dev/null \
	            | sed 's/,.*//' | sort -u)
	[ -n "$families" ] || fail "no fonts found (run: lilith-rice fonts)"
	pick=$(printf '%s\n' "$families" | menu "font:" 14) || exit 0
	[ -n "$pick" ] || exit 0
	set_value font "$pick"
	apply_theme
}

mode_wall() {
	dir="$HOME/Pictures/Wallpapers"
	[ -d "$dir" ] || fail "no $dir (run: lilith-rice wallpapers)"
	pick=$(ls -1 "$dir" | menu "wallpaper:" 12) || exit 0
	[ -n "$pick" ] || exit 0
	set_value wallpaper "$dir/$pick"
	apply_theme
}

mode_wifi() {
	command -v nmcli >/dev/null 2>&1 || fail "nmcli is not installed (NetworkManager)"
	radio=$(nmcli radio wifi)
	map=$(mktemp)
	trap 'rm -f "$map"' EXIT
	{
		printf 'wifi %s: toggle\tTOGGLE\n' "$radio"
		printf 'disconnect\tDISCONNECT\n'
		# fields: IN-USE:SIGNAL:SECURITY:SSID  (only the SSID may contain ':', and it is last)
		nmcli -t -f IN-USE,SIGNAL,SECURITY,SSID dev wifi list --rescan auto 2>/dev/null \
		| while IFS=: read -r use sig sec ssid; do
			ssid=$(printf '%s' "$ssid" | sed 's/\\:/:/g')
			[ -n "$ssid" ] || continue
			mark=" "; [ "$use" = "*" ] && mark="*"
			lock=""; [ -n "$sec" ] && [ "$sec" != "--" ] && lock="  $sec"
			printf '%s %s  %s%%%s\t%s\n' "$mark" "$ssid" "$sig" "$lock" "$ssid"
		done
	} > "$map"
	choice=$(cut -f1 "$map" | menu "wifi:" 12) || exit 0
	[ -n "$choice" ] || exit 0
	target=$(awk -F'\t' -v c="$choice" '$1 == c { print $2; exit }' "$map")
	case "$target" in
		TOGGLE)     [ "$radio" = enabled ] && nmcli radio wifi off || nmcli radio wifi on ;;
		DISCONNECT) dev=$(nmcli -t -f DEVICE,TYPE device | awk -F: '$2 == "wifi" { print $1; exit }')
		            [ -n "$dev" ] && nmcli device disconnect "$dev" ;;
		*)          if nmcli -t -f NAME connection show | grep -qxF "$target"; then
		                nmcli connection up id "$target"
		            elif nmcli -t -f SSID,SECURITY dev wifi list | grep -F "$target:" | grep -qE ':(--)?$'; then
		                nmcli device wifi connect "$target"
		            else
		                # new secured network: nmtui asks for the password without showing it
		                detach foot -T wifi -e nmtui-connect "$target"
		            fi ;;
	esac
}

mode_bluetooth() {
	command -v bluetoothctl >/dev/null 2>&1 || {
		printf 'bluetooth is not installed: run  lilith-rice bluetooth\n' | menu "bluetooth:"
		exit 0
	}
	power=$(bluetoothctl show 2>/dev/null | awk '/Powered:/ { print $2 }')
	map=$(mktemp)
	trap 'rm -f "$map"' EXIT
	{
		printf 'bluetooth power %s: toggle\tTOGGLE\n' "${power:-?}"
		printf 'scan for 8 seconds\tSCAN\n'
		bluetoothctl devices 2>/dev/null | while read -r _ mac name; do
			[ -n "$mac" ] || continue
			connected=$(bluetoothctl info "$mac" 2>/dev/null | awk '/Connected:/ { print $2 }')
			dot="o"; [ "$connected" = yes ] && dot="*"
			printf '%s %s\t%s\n' "$dot" "$name" "$mac"
		done
	} > "$map"
	choice=$(cut -f1 "$map" | menu "bluetooth:" 12) || exit 0
	[ -n "$choice" ] || exit 0
	target=$(awk -F'\t' -v c="$choice" '$1 == c { print $2; exit }' "$map")
	case "$target" in
		TOGGLE) [ "$power" = yes ] && bluetoothctl power off || bluetoothctl power on ;;
		SCAN)   bluetoothctl --timeout 8 scan on >/dev/null 2>&1; exec "$0" bluetooth ;;
		*)      if bluetoothctl info "$target" 2>/dev/null | grep -q 'Connected: yes'; then
		            bluetoothctl disconnect "$target"
		        else
		            bluetoothctl info "$target" 2>/dev/null | grep -q 'Paired: yes' \
		                || { bluetoothctl pair "$target"; bluetoothctl trust "$target"; }
		            bluetoothctl connect "$target"
		        fi ;;
	esac
}

mode_cheat() {
	home=$(cat "$CONF/lilith-rice/home" 2>/dev/null)
	keys="$home/lilith/config/config_keys.h"
	[ -f "$keys" ] || keys="$HOME/.local/src/lilith/config/config_keys.h"
	[ -f "$keys" ] || fail "config_keys.h not found"
	# "/* Super+R: application launcher */"  ->  "Super+R   application launcher"
	sed -n 's|.*/\* \([^:*]*\): \(.*\) \*/.*|\1\t\2|p' "$keys" \
	| grep -E '^(Super|Print|Shift|Ctrl|Alt|left|right|scroll|middle)' \
	| awk -F'\t' '{ printf "%-26s %s\n", $1, $2 }' \
	| menu "keys:" 18 >/dev/null
}

# ---------------------------------------------------------------- dispatch
case "${1:-}" in
	apps)      mode_apps ;;
	clip)      mode_clip ;;
	power)     mode_power ;;
	font)      mode_font ;;
	wall)      mode_wall ;;
	wifi)      mode_wifi ;;
	bluetooth) mode_bluetooth ;;
	cheat)     mode_cheat ;;
	*) echo "usage: lilith-menu apps|clip|power|font|wall|wifi|bluetooth|cheat" >&2; exit 2 ;;
esac
